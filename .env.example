# Production / Vercel: add these in Vercel -> Settings -> Environment Variables.
# IMPORTANT: do NOT prefix these server-only variables with VITE_.
HF_TOKEN=hf_your_token_here
HF_MODEL=openai/gpt-oss-120b:fastest

# Optional local-only development token. This is used only by `npm run dev`.
# It is never read in a production build.
VITE_DEV_HF_TOKEN=hf_your_local_dev_token_here
